# Application Configuration
APP_NAME="Backend Learning Platform API"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
# Default is local SQLite. For PostgreSQL use: postgresql+psycopg2://user:password@localhost:5432/taskdb
DATABASE_URL=sqlite:///./task_management.db

# Security & JWT (CRITICAL: Change JWT_SECRET_KEY in production!)
# In development, minimum 32-character string. Production rejects default placeholders.
JWT_SECRET_KEY=development_secret_key_needs_to_be_at_least_32_chars_long_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Caching & Redis (Optional - falls back to safe in-memory/noop when not available)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=120

